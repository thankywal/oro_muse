{
  "name": "oro-muse",
  "private": true,
  "version": "0.1.0",
  "description": "Oro on Muse: a Messenger shop assistant that answers customers with Meta's Muse models. Meta Global AI Developer Hackathon 2026.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "demo"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "typecheck": "tsc -p packages/muse-provider --noEmit && tsc -p demo --noEmit",
    "demo": "tsx demo/server.ts",
    "talk": "tsx demo/talk.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
